{
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(dropdb *)",
      "Bash(gh api * --method DELETE *)",
      "Bash(gh api * --method PATCH *)",
      "Bash(gh api * --method POST *)",
      "Bash(gh api * -X DELETE *)",
      "Bash(gh api * -X PATCH *)",
      "Bash(gh api * -X POST *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue develop *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue pin *)",
      "Bash(gh issue transfer *)",
      "Bash(gh pr close *)",
      "Bash(gh pr lock *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git clean *)",
      "Bash(git push --delete *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(kubectl delete *)",
      "Bash(mv *)",
      "Bash(psql *DROP*)",
      "Bash(rm *)",
      "Bash(rsync --delete *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "mcp": {
    "allowed": ["memory"],
    "excluded": []
  },
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": ".ai/assets/memory.jsonl"
      }
    }
  }
}
