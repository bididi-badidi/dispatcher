# Dispatcher Configuration
# Copy to `.env` and fill in the required values:
#   cp .env.example .env

# -- Mode selection ---------------------------------------------------------
# REQUIRED: set exactly one of these.
# Single-repo mode:
DISPATCHER_REPO='owner/repo'
# Redis-queue mode (overrides single-repo):
# DISPATCHER_REDIS_URL='redis://default:<password>@<host>:<port>'

# -- GitHub auth ------------------------------------------------------------
# Consumed by the `gh` CLI. Required for polling, branch publishing, and PR work.
# Keep this commented here so no token is committed by accident.
# GITHUB_TOKEN=ghp_xxx

# -- Polling and queue ------------------------------------------------------
DISPATCHER_LABEL=automate
DISPATCHER_POLL_INTERVAL_SECONDS=120.0
DISPATCHER_REDIS_POLL_INTERVAL=60

# -- Branching --------------------------------------------------------------
DISPATCHER_BASE_BRANCH=main
DISPATCHER_BRANCH_PREFIX=feat/issue-

# -- Paths (relative to project root) --------------------------------------
DISPATCHER_STATE_FILE=.dispatcher/state.json
DISPATCHER_LOG_DIR=.dispatcher/logs

# -- Pipeline ---------------------------------------------------------------
# Maximum retry/iteration count for the LangGraph daemon pipeline.
DISPATCHER_MAX_ITERATIONS=3

# -- Agent stage prompts (templates) ---------------------------------------
# Available substitutions:
#   $issue_number  $issue_title  $issue_url
#   $repo          $project_dir   $worktree
#   $base_branch   $branch
DISPATCHER_WORKTREE_COMMAND="Create a git worktree for GitHub issue #$issue_number ($issue_title) based on $base_branch at $worktree using branch $branch."
DISPATCHER_PLAN_COMMAND="Read GitHub issue #$issue_number for this repo. Save the feature implementation plan under branch assets using the project instructions. Do not modify code."
DISPATCHER_BUILD_COMMAND="Read the implementation plan from the branch assets for GitHub issue #$issue_number. Implement it, run relevant checks, push commit to remote, and open a PR with the configured GitHub MCP when it is available. Do not require the gh CLI for PR creation. Stop after PR creation."
